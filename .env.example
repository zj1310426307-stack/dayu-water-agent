DAYU_AGENT_ENV=development
DAYU_AGENT_HOST=0.0.0.0
DAYU_AGENT_PORT=8000

MODEL_PROVIDER=fake
MODEL_NAME=gpt-5.6
OPENAI_API_KEY=

SESSION_STORE=postgres
DATABASE_URL=postgresql+psycopg://dayu_agent:dayu_agent@postgres:5432/dayu_agent
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
PROVIDER_TIMEOUT_SECONDS=60
RETRY_MAX_ATTEMPTS=3
RETRY_MAX_ELAPSED_SECONDS=30
RETRY_BASE_DELAY_SECONDS=0.25
RETRY_MAX_DELAY_SECONDS=2
RETRY_JITTER=true
STREAM_EVENT_RETENTION_SECONDS=86400
MAX_REQUEST_BYTES=1048576
SDK_TRACING_ENABLED=false
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
